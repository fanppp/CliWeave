node_modules/
.next/
dist/
.turbo/
*.log
.env
.env.local
.DS_Store
*.tsbuildinfo

# Per-node platform runtime and provider-native CLI homes stay local.
agents/*/*/runtime/
agents/*/*/data/cli/

# Flat v2 nodes may remain temporarily while a Windows process holds a lock.
agents/*/runtime/
agents/*/data/cli/

# Reserved shared storage defaults.
shared/**/runtime/
shared/**/data/artifacts/

# Credentials at any depth.
**/auth.json
**/.credentials.json

# Legacy v1 node storage, retained only if migration needs a later retry.
agents/*/memory/
agents/*/sessions/
