{
  "schemaVersion": 4,
  "localId": "code-reviewer",
  "name": "Codex 代码审核",
  "provider": "codex",
  "cli": { "command": "codex", "sandboxMode": "danger-full-access", "extraArgs": [], "promptVia": "stdin", "cwd": "${PROJECT_PATH}" },
  "storage": {
    "config": { "identityFile": "config/identity.md", "rulesFiles": ["config/rules/*.md"] },
    "runtime": { "activeSessionFile": "runtime/active-session.json", "resume": true },
    "data": { "cliHome": "data/cli/.codex" }
  }
}
