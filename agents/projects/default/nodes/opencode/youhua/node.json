{
  "schemaVersion": 4,
  "localId": "youhua",
  "name": "优化",
  "provider": "opencode",
  "cli": {
    "command": "opencode",
    "sandboxMode": "danger-full-access",
    "extraArgs": [],
    "promptVia": "stdin",
    "cwd": "${PROJECT_PATH}"
  },
  "model": "alibaba-cn/glm-5.2",
  "storage": {
    "config": {
      "identityFile": "config/identity.md",
      "rulesFiles": [
        "config/rules/*.md"
      ]
    },
    "runtime": {
      "activeSessionFile": "runtime/active-session.json",
      "resume": true
    },
    "data": {
      "cliHome": "data/cli/.opencode"
    }
  }
}
