{
  "schemaVersion": 3,
  "localId": "youhua",
  "name": "优化",
  "provider": "opencode",
  "cli": {
    "command": "opencode",
    "sandboxMode": "danger-full-access",
    "extraArgs": [],
    "promptVia": "stdin",
    "cwd": "${PROJECT_ROOT}"
  },
  "model": "alibaba-cn/glm-5.2",
  "storage": {
    "config": {
      "identityFile": "agents/opencode/youhua/config/identity.md",
      "rulesFiles": [
        "agents/opencode/youhua/config/rules/*.md"
      ]
    },
    "runtime": {
      "activeSessionFile": "agents/opencode/youhua/runtime/active-session.json",
      "resume": true
    },
    "data": {
      "cliHome": "agents/opencode/youhua/data/cli/.opencode"
    }
  }
}
