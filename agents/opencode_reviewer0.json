{
  "id": "opencode_reviewer0",
  "name": "opencode-reviewer",
  "provider": "codex",
  "cli": {
    "command": "codex",
    "sandboxMode": "danger-full-access",
    "extraArgs": [],
    "promptVia": "stdin",
    "cwd": "${PROJECT_ROOT}"
  },
  "model": "",
  "prompt": {
    "identity": "agents/opencode_reviewer0/identity.md"
  },
  "rules": {
    "files": [
      "agents/opencode_reviewer0/rules/*.md"
    ]
  },
  "memory": {
